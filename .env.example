# Flask
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
# SECRET_KEY is mandatory in production (min 16 characters). Do not commit this file.
SECRET_KEY=change-me-in-production

# Database (MySQL 8 via PyMySQL). Never leave DB_PASSWORD empty in production.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecotrack
DB_USER=ecotrack_user
DB_PASSWORD=change-me

# File uploads
MAX_CONTENT_LENGTH=5242880
# Private uploads live outside the public static directory.
UPLOAD_FOLDER=instance/uploads
